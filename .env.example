# ── Core ──────────────────────────────────────────────────────────────────────
# API key for Claude model access (REQUIRED — get one at console.anthropic.com)
ANTHROPIC_API_KEY=

# Bot display name (default: Andy). If a chat group with this exact name exists,
# the bot auto-registers it as the main group on first startup.
ASSISTANT_NAME=Andy

# Timezone for message timestamps and scheduled tasks (e.g. America/Los_Angeles)
TZ=UTC

# GitHub personal access token — only needed to install skills from private repos
GITHUB_TOKEN=

# ── Slack (optional channel) ──────────────────────────────────────────────────
# Bot User OAuth Token (xoxb-...) + App-Level Token for Socket Mode (xapp-...)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# (Optional) Channel ID to auto-register as the main group
SLACK_MAIN_CHANNEL_ID=

# ── Telegram (optional channel) ───────────────────────────────────────────────
# Bot token from @BotFather (123456:ABC-...)
TELEGRAM_BOT_TOKEN=

# ── Discord (optional channel) ────────────────────────────────────────────────
# Bot token from the Discord Developer Portal
DISCORD_BOT_TOKEN=

# ── WhatsApp (optional channel) ───────────────────────────────────────────────
# Your phone number in international format, no plus sign (e.g. 12125551234)
WHATSAPP_PHONE=

# ── Gmail (optional channel) ──────────────────────────────────────────────────
# OAuth credentials from Google Cloud Console (see README for the setup flow)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=